# ========================
# LUCAS — .gitignore
# ========================
# Cargo.lock est volontairement versionné : le projet produit des binaires.

# Secrets et configuration locale
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
.credentials.json
secrets/
docker-compose.override.yml

# Rust
target/
**/*.rs.bk
*.pdb
*.profraw
*.profdata
mutants.out*/

# Données locales, bases et journaux
data/
logs/
*.log
*.db
*.sqlite
*.sqlite3

# Modèles IA (LLM, Whisper, Piper : trop volumineux pour Git)
models/
weights/
*.gguf
*.ggml
*.bin
*.onnx

# Outils d'assistance au code (IA)
.claude/
CLAUDE.local.md
.codex/
.cursor/
.aider*
.windsurf/
.continue/
.gemini/
graphify-out/

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Éditeurs
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
