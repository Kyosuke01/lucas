# Configuration facultative de LUCAS : `docker compose up -d` fonctionne sans.
# Pour changer un réglage, copier ce fichier en .env (jamais versionné).

LUCAS_PORT="8080"                    # Interface LUCAS
OLLAMA_DEFAULT_MODEL="llama3.1:8b"   # Modèle téléchargé au premier démarrage
OLLAMA_NUM_PARALLEL="2"              # Réponses écrites en même temps (mémoire en plus à chacune)
OLLAMA_MAX_LOADED_MODELS="1"         # Modèles gardés en mémoire ; 2 demande bien plus de 8 Go
